# ==========================================
# LoanFlow AI - Backend Environment Template
# Copy this file to backend/.env and update values
# ==========================================

# Application Settings
ENVIRONMENT=development
DEBUG=True
HOST=127.0.0.1
PORT=8000
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# Security
SECRET_KEY=replace-with-a-secure-random-32-byte-hex-string
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Database (PostgreSQL)
POSTGRES_USER=loanflow
POSTGRES_PASSWORD=loanflow_secret_password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=loanflow_db
DATABASE_URL=postgresql+asyncpg://loanflow:loanflow_secret_password@localhost:5432/loanflow_db

# File Storage
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=25
ALLOWED_FILE_TYPES=["application/pdf","image/png","image/jpeg","image/tiff"]

# OCR Configuration
# Windows default path example: C:\Program Files\Tesseract-OCR\tesseract.exe
TESSERACT_CMD=

# LLM / Ollama Configuration
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1
OLLAMA_TIMEOUT=120
